{
  "name": "@lamka02sk/proza",
  "version": "0.1.2",
  "description": "Block-based WYSIWYG editor, written from scratch.",
  "keywords": [
    "editor",
    "wysiwyg",
    "block-editor",
    "contenteditable",
    "vue",
    "accessibility"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lamka02sk/proza.git"
  },
  "homepage": "https://github.com/lamka02sk/proza#readme",
  "bugs": {
    "url": "https://github.com/lamka02sk/proza/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./render": {
      "types": "./dist/types/render-entry.d.ts",
      "import": "./dist/lib/render.js"
    },
    "./element": {
      "types": "./dist/types/element.d.ts",
      "import": "./dist/lib/element.js"
    },
    "./vue": {
      "types": "./dist/types/vue.d.ts",
      "import": "./dist/lib/vue.js"
    },
    "./locales/sk": {
      "types": "./dist/types/locales/sk.d.ts",
      "import": "./dist/lib/locales/sk.js"
    },
    "./locales/cs": {
      "types": "./dist/types/locales/cs.d.ts",
      "import": "./dist/lib/locales/cs.js"
    },
    "./locales/de": {
      "types": "./dist/types/locales/de.d.ts",
      "import": "./dist/lib/locales/de.js"
    },
    "./locales/es": {
      "types": "./dist/types/locales/es.d.ts",
      "import": "./dist/lib/locales/es.js"
    },
    "./locales/fr": {
      "types": "./dist/types/locales/fr.d.ts",
      "import": "./dist/lib/locales/fr.js"
    },
    "./locales/hu": {
      "types": "./dist/types/locales/hu.d.ts",
      "import": "./dist/lib/locales/hu.js"
    },
    "./content.css": "./dist/lib/content.css",
    "./sanitizer-policy.json": "./dist/lib/sanitizer-policy.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "dist/types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "node -e \"require('fs').rmSync('dist/types',{recursive:true,force:true})\" && vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:playground": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.model.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "package": "node scripts/check-package.mjs",
    "api": "node scripts/api-report.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm package && pnpm api --check && pnpm e2e",
    "e2e:annotations": "node scripts/e2e-annotations.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "reka-ui": "2.9.10",
    "vue": "^3.5.45"
  }
}
